# ============================================================
# App
# ============================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# ============================================================
# Supabase - Public
# Browserで使ってよい値。
# RLSで必ず保護する。
# ============================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# ============================================================
# Supabase - Server Only
# 原則使わない。使う場合はserver-onlyに閉じる。
# Browserに絶対出さない。
# ============================================================

SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# ============================================================
# AI Provider
# ============================================================

AI_PROVIDER=mock

OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CODEX_MODEL=

GEMINI_API_KEY=replace-with-gemini-key
GEMINI_MODEL=gemini-2.0-flash

# AI behavior
AI_TIMEOUT_MS=30000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# ============================================================
# Embeddings / RAG
# ============================================================

EMBEDDING_PROVIDER=mock

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

RAG_MATCH_THRESHOLD=0.75
RAG_MATCH_COUNT=8
RAG_MAX_CONTEXT_CHARS=6000

# ============================================================
# Safety / Logs / Evals
# ============================================================

ENABLE_SAFETY_CHECK=true
ENABLE_AI_LOGGING=true
ENABLE_EVAL_MODE=false

AI_LOG_PAYLOADS=false

# ============================================================
# Rate Limit / Cost Limit
# ============================================================

ENABLE_RATE_LIMIT=true
ENABLE_COST_LIMIT=true
DEFAULT_MONTHLY_AI_COST_LIMIT_USD=1

# ============================================================
# Cron
# ============================================================

CRON_SECRET=replace-with-random-secret

# ============================================================
# Documents
# ============================================================

DOCUMENTS_BUCKET=documents
MAX_DOCUMENT_UPLOAD_BYTES=10485760
MAX_EXTRACTED_TEXT_CHARS=100000

# ============================================================
# Other server-only secrets reserved for later integrations.
# Never create NEXT_PUBLIC_ variants of server-only secrets.
# ============================================================

STRIPE_SECRET_KEY=
VAPID_PRIVATE_KEY=

# Development-only AI assistant surface.
# Do not use this for production user-facing AI execution.
DEVELOPMENT_AI_ASSISTANT=codex-sdk
