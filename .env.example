# MVP database. The mvp branch defaults to SQLite unless DB_PROVIDER=supabase.
DB_PROVIDER=sqlite
NEXT_PUBLIC_DB_PROVIDER=sqlite
SQLITE_DATABASE_FILENAME=ruletrade-mvp.sqlite

# Supabase public values. Required only when DB_PROVIDER=supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase server-only secret. Required only when DB_PROVIDER=supabase.
SUPABASE_SERVICE_ROLE_KEY=

# AI Provider
AI_PROVIDER=mock

# Development-only AI assistant surface.
# Do not use this for production user-facing AI execution.
DEVELOPMENT_AI_ASSISTANT=codex-sdk

# Server-only AI secrets
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_CODEX_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

# AI behavior
AI_TIMEOUT_MS=30000

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Other server-only secrets reserved for later integrations.
STRIPE_SECRET_KEY=
CRON_SECRET=
VAPID_PRIVATE_KEY=

# Never create NEXT_PUBLIC_ variants of server-only secrets.

# App
APP_URL=http://localhost:3000

# Feature Flags
ENABLE_SAFETY_CHECK=true
ENABLE_AI_LOGGING=true
ENABLE_EVAL_MODE=false
