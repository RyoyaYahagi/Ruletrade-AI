GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
RULETRADE_DATABASE_PATH=.data/ruletrade-mvp.sqlite

# Feedback is stored only in RyoyaYahagi/Ruletrade-AI GitHub Issues.
# Fine-grained token: select this repository, Issues: Read and write.
GITHUB_FEEDBACK_TOKEN=
# Preferred: local Jev Gateway (upstream credential stays in the gateway).
JEV_GATEWAY_URL=http://127.0.0.1:4789/v1/systemone
JEV_GATEWAY_TOKEN=
# Direct TypeSafe access only: clear JEV_GATEWAY_URL and configure this server secret.
TYPESAFE_API_KEY=
