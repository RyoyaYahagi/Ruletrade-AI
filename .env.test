# ============================================================
# E2E Test Environment
# ============================================================

NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=test

# Use SQLite for fast, isolated E2E tests
SQLITE_DATABASE_PATH=./data/e2e-test.sqlite
LOCAL_STORAGE_PATH=./data/e2e-test-storage

# Mock auth for deterministic E2E testing
E2E_TEST_AUTH=true
MOCK_AUTH_EMAIL=e2e@example.com
MOCK_AUTH_USER_ID=e2e-test-user
MOCK_AUTH_ROLE=user

# Mock AI provider to avoid external API costs/flakiness in tests
AI_PROVIDER=mock

# Disable rate limiting in tests
ENABLE_RATE_LIMIT=false
ENABLE_COST_LIMIT=false

# Disable eval mode
ENABLE_EVAL_MODE=false
